flowchart TB
    INPUT["统一输入协议<br/><b>同一历史 H</b> · 仅 t ≤ 0 的 ego state / waypoint<br/>未来 8 帧 · 4 秒 · 2 Hz · 精确相机标定"]

    subgraph IMAGE["A. 想象未来测量分支 · Action-blind"]
        direction LR
        FV["WAM 未来图像<br/>F = {I₁ … I₈}"] --> RAFT["RAFT-Large<br/>前后向一致性<br/>静态地面证据"]
        RAFT --> GEO["地面平面自车几何<br/>历史速度只作尺度先验"]
        GEO --> DEC["候选无关连续解码器<br/>Observability / Abstention"]
        DEC --> MF["<b>图像运动后验 m_F(t)</b><br/>v · a · v_lat · yaw-rate · curvature<br/>q05 / q50 / q95"]
    end

    subgraph ACTION["B. 原生动作分支 · 隔离到图像解码完成之后"]
        direction LR
        AH["同一 WAM<br/>Action head"] --> GATE["信息隔离门<br/>禁止 waypoint 进入图像分支"]
        GATE --> KIN["确定性 waypoint 运动学<br/>统一时间轴与自车坐标系"]
        KIN --> MA["<b>动作运动曲线 m_A(t)</b><br/>v · a · v_lat · yaw-rate · curvature"]
    end

    INPUT --> FV
    INPUT --> AH

    MF --> ALIGN
    MA --> ALIGN
    ALIGN["<b>Level 1 · Continuous Foresight–Action Alignment</b><br/>逐时刻误差 · 后验覆盖率 · Coverage–Risk<br/>主输出是连续量，不是文字事件"]

    PAIR["受控反事实对<br/>同一 H · 同一模型 · 同一 nuisance seed<br/>clear ↔ risk"] --> DF["Δm_F(t)<br/>risk future − clear future"]
    PAIR --> DA["Δm_A(t)<br/>risk action − clear action"]
    DF --> CF
    DA --> CF
    CF["<b>Level 2 · Counterfactual Continuous Consistency</b><br/>响应符号 · 幅度 · 时序 · 曲线余弦一致性"]

    ALIGN --> INTERP
    CF --> INTERP
    INTERP["事件解释层（次级）<br/>刹车 · 转向 · 停车 · 避让<br/>仅用于分层、检索和案例解释"]

    CF --> ROLLOUT["独立闭环执行<br/>realized state + task success"]
    ROLLOUT --> FCS["<b>Level 3 · Foresight-Conditioned Success</b><br/>因果闭环；缺少独立执行数据则 fail closed"]

    L0["Level 0 · Probe Validation<br/>logged future 仅验证图像测量能力<br/>不产生 WAM 因果结论"] -. 校准 .-> DEC

    classDef input fill:#f4f4f5,stroke:#52525b,color:#18181b,stroke-width:1.5px;
    classDef image fill:#e8f1fb,stroke:#2563a6,color:#102a43,stroke-width:1.5px;
    classDef action fill:#eaf6ee,stroke:#2f855a,color:#153d2b,stroke-width:1.5px;
    classDef primary fill:#fff4d6,stroke:#b7791f,color:#4a2c0a,stroke-width:2px;
    classDef secondary fill:#f4ecfa,stroke:#8056a8,color:#352044,stroke-width:1.5px;
    classDef warning fill:#fff0f0,stroke:#b83a3a,color:#551919,stroke-width:1.5px,stroke-dasharray:5 3;

    class INPUT,PAIR input;
    class FV,RAFT,GEO,DEC,MF,DF image;
    class AH,GATE,KIN,MA,DA action;
    class ALIGN,CF,FCS primary;
    class INTERP secondary;
    class L0,ROLLOUT warning;
