flowchart TB
    INPUT["Level 1 固定输入<br/><b>同一历史 H</b> · 仅 t ≤ 0 的 state / waypoint<br/>WAM future images · 原生 action waypoint<br/>目标协议：8 帧 / 4 秒 / 2 Hz"]

    INPUT --> IMAGE
    INPUT --> HISTORY
    INPUT --> ACTION

    subgraph IMAGE["Future evidence · Action-blind"]
        direction LR
        FI["未来图像"] --> RAFT["RAFT-Large<br/>F/B consistency"]
        RAFT --> GEO["地面自车几何<br/>Observability"]
        GEO --> MF["<b>m_F(t)</b><br/>v · a · v_lat<br/>yaw-rate · curvature<br/>q05 / q50 / q95"]
    end

    subgraph HISTORY["Strong history-only null · 不读未来"]
        direction LR
        HS["历史 state"] --> CA["Constant-acceleration<br/>Constant-yaw-rate"]
        CA --> MH["<b>m_H(t)</b>"]
    end

    subgraph ACTION["Held-out native action · 解码后才读取"]
        direction LR
        AW["Action waypoint"] --> KIN["确定性运动学<br/>统一时间轴 / 自车坐标"]
        KIN --> MA["<b>m_A(t)</b>"]
    end

    MF --> DF["D_F = d(m_F, m_A)<br/>连续 MAE / RMSE"]
    MA --> DF
    MH --> DH["D_H = d(m_H, m_A)"]
    MA --> DH
    DF --> GAIN["<b>Foresight Gain</b><br/>G_H = D_H − D_F"]
    DH --> GAIN

    MF --> CTRL["Future specificity controls<br/>history-speed matched shuffle<br/>time reversal"]
    CTRL --> DC["D_ctrl = d(m_F,ctrl, m_A)"]
    MA --> DC
    DC --> LIFT["<b>Specificity Lift</b><br/>L_ctrl = D_ctrl − D_F"]
    DF --> LIFT

    MF --> PROB["<b>Uncertainty quality</b><br/>90% coverage · width<br/>Interval Score · WIS<br/>Coverage–Risk"]

    GAIN --> GATE
    LIFT --> GATE
    PROB --> GATE
    GATE["<b>逐分量 Level 1 门槛</b><br/>Gain、shuffle lift、time-order lift<br/>样本级 bootstrap 95% CI 下界均 > 0<br/>速度后验必须校准"]

    GATE --> REPORT["Level 1 输出<br/>连续对齐 + 增量信息 + specificity + uncertainty<br/>不使用事件标签 · 不声称干预因果"]

    classDef input fill:#f4f4f5,stroke:#52525b,color:#18181b,stroke-width:1.5px;
    classDef image fill:#e8f1fb,stroke:#2563a6,color:#102a43,stroke-width:1.5px;
    classDef history fill:#f3ecfb,stroke:#7952a8,color:#352044,stroke-width:1.5px;
    classDef action fill:#eaf6ee,stroke:#2f855a,color:#153d2b,stroke-width:1.5px;
    classDef primary fill:#fff4d6,stroke:#b7791f,color:#4a2c0a,stroke-width:2px;
    classDef output fill:#fff0f0,stroke:#b83a3a,color:#551919,stroke-width:1.5px;

    class INPUT input;
    class FI,RAFT,GEO,MF,DF image;
    class HS,CA,MH,DH history;
    class AW,KIN,MA action;
    class GAIN,CTRL,DC,LIFT,PROB,GATE primary;
    class REPORT output;
